<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_dark_bg">

    <!-- Header -->
    <LinearLayout
        android:id="@+id/header"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp"
        android:background="@color/color_darker_bg"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="✨ Catalog Photo Ready!"
            android:textColor="@color/color_gold_light"
            android:textSize="22sp"
            android:fontFamily="serif"
            android:textStyle="bold"
            android:layout_gravity="center"
            android:layout_marginBottom="2dp" />

        <TextView
            android:id="@+id/tvResultTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=""
            android:textColor="@color/color_cream"
            android:textSize="15sp"
            android:layout_gravity="center" />

        <TextView
            android:id="@+id/tvArtisanCredit"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=""
            android:textColor="@color/color_gold"
            android:textSize="13sp"
            android:fontFamily="serif"
            android:textStyle="italic"
            android:layout_gravity="center" />

    </LinearLayout>

    <!-- Gold divider -->
    <View
        android:id="@+id/divider"
        android:layout_width="0dp"
        android:layout_height="2dp"
        android:background="@color/color_gold"
        app:layout_constraintTop_toBottomOf="@id/header"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Branded image preview -->
    <ImageView
        android:id="@+id/imgBrandedResult"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_margin="16dp"
        android:scaleType="fitCenter"
        android:contentDescription="Branded product photo"
        app:layout_constraintTop_toBottomOf="@id/divider"
        app:layout_constraintBottom_toTopOf="@id/bottomButtons"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Bottom action buttons -->
    <LinearLayout
        android:id="@+id/bottomButtons"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp"
        android:background="@color/color_darker_bg"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Save + WhatsApp row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="10dp">

            <Button
                android:id="@+id/btnSave"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:text="💾  Save to Gallery"
                android:textSize="14sp"
                android:textStyle="bold"
                android:background="@drawable/bg_button_outline"
                android:textColor="@color/color_gold" />

            <Button
                android:id="@+id/btnShareWhatsapp"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:text="📱  WhatsApp"
                android:textSize="14sp"
                android:textStyle="bold"
                android:background="@drawable/bg_button_green"
                android:textColor="@android:color/white" />

        </LinearLayout>

        <!-- Share & New Photo row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnShare"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:text="🔗  Share More"
                android:textSize="14sp"
                android:textStyle="bold"
                android:background="@drawable/bg_button_gold"
                android:textColor="@color/color_dark_bg" />

            <Button
                android:id="@+id/btnNewPhoto"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:text="📷  New Photo"
                android:textSize="14sp"
                android:textStyle="bold"
                android:background="@drawable/bg_button_outline"
                android:textColor="@color/color_cream" />

        </LinearLayout>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
