<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_dark_bg">

    <!-- Decorative top line -->
    <View
        android:id="@+id/viewTopAccent"
        android:layout_width="0dp"
        android:layout_height="3dp"
        android:background="@color/color_gold"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- App Icon placeholder -->
    <TextView
        android:id="@+id/tvIcon"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="🪵"
        android:textSize="80sp"
        app:layout_constraintBottom_toTopOf="@id/tvAppName"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed"
        android:layout_marginBottom="24dp" />

    <!-- App Name -->
    <TextView
        android:id="@+id/tvAppName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Shilpa-Kala"
        android:textColor="@color/color_gold_light"
        android:textSize="48sp"
        android:fontFamily="serif"
        android:textStyle="bold|italic"
        android:letterSpacing="0.05"
        app:layout_constraintBottom_toTopOf="@id/tvTagline"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginBottom="12dp"/>

    <!-- Tagline -->
    <TextView
        android:id="@+id/tvTagline"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Digital Portfolio Assistant"
        android:textColor="@color/color_cream"
        android:textSize="18sp"
        android:letterSpacing="0.1"
        app:layout_constraintBottom_toTopOf="@id/tvSubTagline"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginBottom="8dp"/>

    <TextView
        android:id="@+id/tvSubTagline"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="✦ For Karnataka Artisans ✦"
        android:textColor="@color/color_gold"
        android:textSize="14sp"
        android:letterSpacing="0.15"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvIcon"/>

    <!-- Bottom Made in India -->
    <TextView
        android:id="@+id/tvMadeInIndia"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Empowering Artisans • Handmade in Karnataka"
        android:textColor="#88C9A84C"
        android:textSize="12sp"
        android:letterSpacing="0.1"
        android:layout_marginBottom="32dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- Bottom gold accent -->
    <View
        android:layout_width="0dp"
        android:layout_height="3dp"
        android:background="@color/color_gold"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
