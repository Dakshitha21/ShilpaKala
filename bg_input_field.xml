    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#0FC9A84C" />
            <stroke android:width="1dp" android:color="#55C9A84C" />
            <corners android:radius="8dp" />
        </shape>
    </item>
</selector>
